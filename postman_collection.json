{
  "info": {
    "_postman_id": "c1f7a4e2-63b9-4912-8e81-7dfa932c510e",
    "name": "Smart Campus Access Control System - API Gateway",
    "description": "Comprehensive Postman test collection for the Distributed Campus Access Control System. Fully synchronized with MongoDB Atlas (clusterdb) and the Gateway UI console (http://localhost:4000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "facultyToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Registration",
      "item": [
        {
          "name": "1.1 Register Admin User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Director\",\n  \"email\": \"admin@campus.edu\",\n  \"password\": \"Password123!\",\n  \"role\": \"admin\",\n  \"department\": \"Campus Security\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reg",
              "host": ["{{baseUrl}}"],
              "path": ["reg"]
            },
            "description": "Registers an administrator account stored persistently in MongoDB Atlas."
          },
          "response": []
        },
        {
          "name": "1.2 Login Admin (Auto-saves adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set(\"adminToken\", json.token);",
                  "    pm.environment.set(\"adminToken\", json.token);",
                  "    console.log(\"Saved adminToken:\", json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campus.edu\",\n  \"password\": \"Password123!\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "Logs in as admin and automatically stores JWT token in {{adminToken}}."
          },
          "response": []
        },

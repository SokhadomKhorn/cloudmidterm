    {
      "name": "2. Room Management (Protected)",
      "item": [
        {
          "name": "2.1 List All Campus Rooms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            },
            "description": "Returns live room inventory from MongoDB Atlas. Synchronized with the web UI table."
          },
          "response": []
        },
        {
          "name": "2.2 Create Room (Admin Clearance)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"ENG-301\",\n  \"roomName\": \"Software Engineering Lab\",\n  \"building\": \"Engineering Hall\",\n  \"floor\": 3,\n  \"roomType\": \"LAB\",\n  \"capacity\": 50,\n  \"securityClearance\": \"GENERAL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            },
            "description": "Creates a new room in MongoDB Atlas. Immediately renders in the web console."
          },
          "response": []
        },
        {
          "name": "2.3 Lock Room (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms/ENG-301/lock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "ENG-301", "lock"]
            },
            "description": "Manually engages electronic deadbolt on target room."
          },
          "response": []
        },
        {
          "name": "2.4 Unlock Room (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lock\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms/ENG-301/lock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "ENG-301", "lock"]
            },
            "description": "Unlocks electronic deadbolt on target room."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Negative Test Cases (Assignment Requirements)",
      "item": [
        {
          "name": "3.1 Wrong Password (Expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campus.edu\",\n  \"password\": \"WRONG_PASSWORD_123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "Negative check 4.1: Submitting incorrect password returns 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "3.2 Missing Token (Expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            },
            "description": "Negative check 4.2: Requesting protected resource with no token returns 401."
          },
          "response": []
        },
        {
          "name": "3.3 Invalid Token (Expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer fake123"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            },
            "description": "Negative check 4.3: Submitting invalid/forged Bearer token returns 403 Forbidden."
          },
          "response": []
        },
        {
          "name": "3.4 RBAC - Student Cannot Create Room (Expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Role student unauthorized message\", function () {",
                  "    pm.expect(json.message).to.include(\"Role 'student' is unauthorized\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"ENG-999\",\n  \"roomName\": \"Unauthorized Room\",\n  \"building\": \"Engineering Hall\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            },
            "description": "Negative check 4.4: Role-Based Access Control denies room creation to students."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Door Swipe & Round-Robin Load Balancer",
      "item": [
        {
          "name": "4.1 Badge Swipe Request 1 (Routes to Node 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Header X-Load-Balanced-By is API-Gateway-RoundRobin\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-Load-Balanced-By\")).to.eql(\"API-Gateway-RoundRobin\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USR-1001\",\n  \"userEmail\": \"student@campus.edu\",\n  \"userRole\": \"student\",\n  \"roomId\": \"ROOM-ENG-301\",\n  \"roomNumber\": \"ENG-301\",\n  \"building\": \"Engineering Hall\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/logs/swipe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logs", "swipe"]
            },
            "description": "Simulates door reader badge swipe. Gateway load balancer routes to AccessLog-Instance-1 or AccessLog-Instance-2."
          },
          "response": []
        },

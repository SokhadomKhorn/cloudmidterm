              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Header X-Load-Balanced-By is API-Gateway-RoundRobin\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-Load-Balanced-By\")).to.eql(\"API-Gateway-RoundRobin\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USR-1001\",\n  \"userEmail\": \"student@campus.edu\",\n  \"userRole\": \"student\",\n  \"roomId\": \"ROOM-ENG-301\",\n  \"roomNumber\": \"ENG-301\",\n  \"building\": \"Engineering Hall\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/logs/swipe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logs", "swipe"]
            },
            "description": "Second consecutive swipe. Verifies round-robin alternating distribution."
          },
          "response": []
        }
      ]
    },
